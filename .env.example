# JWT Authentication
JWT_SECRET=replace-with-at-least-32-characters
JWT_EXPIRES_IN=24h

# Initial Admin Account
ADMIN_USER=admin
# Generate with:
# node -e "import('bcryptjs').then(async b => console.log(await b.hash('change-me', 10)))"
ADMIN_PASSWORD_HASH=$2a$10$replace-with-bcrypt-hash

# Data Storage
DATA_DIR=./data

# MCP stdio authentication
MCP_API_KEY=replace-with-user-mcp-key

# Chip configuration
CHIP_CONFIG_FILE=./config/chips.json
